# Only needed for live Garmin sync (first login: python -m app.garmin_sync --login)
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Optional: model for headless Claude Code (default = your Claude Code default), e.g. sonnet or opus
# CLAUDE_MODEL=

# Optional: token safeguards (defaults shown)
# CLAUDE_DAILY_RUN_LIMIT=30   # Claude runs per local day
# CLAUDE_MAX_TOOL_CALLS=15    # tool calls per run before it is stopped
# CLAUDE_RUN_TIMEOUT_S=240    # seconds per run before it is stopped
# CLAUDE_MAX_CHAT_TURNS=20    # messages per chat before you must start a new one
